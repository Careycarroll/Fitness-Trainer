{
  "name": "fitness-tracker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, single-user training planner. Deterministic rules engine, phone-first PWA.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "validate": "python3 tools/build_seed.py --check && node scripts/validate.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run validate && npm test",
    "build:seed": "python3 tools/build_seed.py"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
